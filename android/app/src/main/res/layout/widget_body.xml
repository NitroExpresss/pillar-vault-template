<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Тело»: шапка, вес и путь к цели, график веса картинкой
     (рисует BodyWidget под размер виджета). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/body_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_night"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/body_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_body_title"
            android:textColor="#8EE4AF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/body_when"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="#7B9476"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/body_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/widget_body_add"
            android:gravity="center"
            android:text="+"
            android:textColor="#5CDB95"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/body_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/widget_refresh"
            android:gravity="center"
            android:text="↻"
            android:textColor="#5CDB95"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/body_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#EDF5E1"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/body_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#BBD3B4"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/body_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:fontFamily="monospace"
            android:textColor="#5CDB95"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/body_progress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressBackgroundTint="#4D7B8F86"
        android:progressTint="#2FAE6B" />

    <TextView
        android:id="@+id/body_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#C79C88"
        android:textSize="11sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/body_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_body_chart"
        android:scaleType="fitXY" />
</LinearLayout>
