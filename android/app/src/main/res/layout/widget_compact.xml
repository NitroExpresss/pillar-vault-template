<?xml version="1.0" encoding="utf-8"?>
<!-- Сжатый виджет-список (одна клетка в высоту): заголовок, крупное число и
     одна строка сути — «Сегодня 3 · Позвонить врачу». Цвета — по небу. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cmp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_night"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cmp_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="#8EE4AF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/cmp_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#A7BDB3"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/cmp_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#E6F2EA"
        android:textSize="24sp" />
</LinearLayout>
