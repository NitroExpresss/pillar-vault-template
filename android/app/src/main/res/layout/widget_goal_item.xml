<?xml version="1.0" encoding="utf-8"?>
<!-- Строка «Целей»: название и темп, срок и пройденный путь, график
     (картинка — рисует GoalsWidgetService) и результаты одной строкой. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/goal_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/goal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#E6F2EA"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/goal_pace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#A7BDB3"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/goal_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#A7BDB3"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/goal_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_goals_chart"
        android:scaleType="fitStart" />

    <TextView
        android:id="@+id/goal_krs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#A7BDB3"
        android:textSize="12sp" />
</LinearLayout>
