<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/item_check"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_check"
        android:contentDescription="@string/widget_done" />

    <TextView
        android:id="@+id/item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="#EDF5E1"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/item_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:fontFamily="monospace"
        android:textColor="#C79C88"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- «на завтра»: срок дела переезжает на завтра; у покупок кнопки нет -->
    <TextView
        android:id="@+id/item_later"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/widget_later"
        android:gravity="center"
        android:text="→"
        android:textColor="#3EE08A"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>
