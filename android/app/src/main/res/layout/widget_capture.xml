<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Захват»: шесть плиток — дело, покупка, дневник, замер, что ел, мысль.
     Каждая открывает окно ввода поверх рабочего стола. Цвета — по небу (Sky). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cap_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_night"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/cap_title"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:text="@string/widget_capture_title"
        android:textColor="#8EE4AF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cap_task"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="44dp"
            android:text="Дело"
            android:textColor="#E6F2EA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cap_shop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="44dp"
            android:text="Покупка"
            android:textColor="#E6F2EA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cap_diary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="44dp"
            android:text="Дневник"
            android:textColor="#E6F2EA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cap_metric"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="44dp"
            android:text="Замер"
            android:textColor="#E6F2EA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cap_food"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="44dp"
            android:text="Что ел"
            android:textColor="#E6F2EA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cap_thought"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="44dp"
            android:text="Мысль"
            android:textColor="#E6F2EA"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
