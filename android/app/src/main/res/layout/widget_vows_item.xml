<?xml version="1.0" encoding="utf-8"?>
<!-- Строка столпа: имя и правило (нажатие — карточка), стрик, ✓ и ✗.
     Кнопки по 40dp — под палец; активная отметка залита цветом. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="46dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/vow_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/vow_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#EDF5E1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vow_rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#7B9476"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/vow_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="monospace"
        android:textColor="#C79C88"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/vow_held"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_mark"
        android:contentDescription="@string/widget_vow_held"
        android:gravity="center"
        android:text="✓"
        android:textColor="#5CDB95"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/vow_broke"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_mark"
        android:contentDescription="@string/widget_vow_broke"
        android:gravity="center"
        android:text="✗"
        android:textColor="#E06C5F"
        android:textSize="17sp" />
</LinearLayout>
