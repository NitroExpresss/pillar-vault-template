<?xml version="1.0" encoding="utf-8"?>
<!-- Полоса во всю ширину (4 клетки) и одну высоту: пять плиток в ряд.
     Уже 250dp плиткам тесно — растягивается в высоту и до всей ширины. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_capture_description"
    android:initialLayout="@layout/widget_capture"
    android:minWidth="250dp"
    android:minHeight="70dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="70dp"
    android:previewImage="@drawable/widget_capture_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
