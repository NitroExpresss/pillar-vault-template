<?xml version="1.0" encoding="utf-8"?>
<!-- День: глубокое сине-бирюзовое небо, приглушённое солнце справа сверху.
     Тема только тёмная. Слои как в приложении: градиент неба, пятно солнца,
     стеклянная вуаль — вуаль держит контраст светлых чернил. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#071526" android:centerColor="#0F2A3D" android:endColor="#173F46" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.86" android:centerY="0.02" android:gradientRadius="200dp"
                android:startColor="#6BFFECC8" android:centerColor="#29FFC88C" android:endColor="#00FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#73081420" />
            <stroke android:width="1dp" android:color="#1F78FFB4" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
