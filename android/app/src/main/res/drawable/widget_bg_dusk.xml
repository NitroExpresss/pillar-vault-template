<?xml version="1.0" encoding="utf-8"?>
<!-- Закат: сине-сиреневое небо, солнце садится справа внизу.
     Слои как в приложении: градиент неба, пятно солнца, стеклянная вуаль —
     вуаль держит контраст чернил над любой частью неба. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1C2A50" android:centerColor="#5E4A78" android:endColor="#E58F64" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.88" android:centerY="0.98" android:gradientRadius="190dp"
                android:startColor="#FFFFE2B4" android:centerColor="#8CFF8C5A" android:endColor="#00FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8C16182C" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
