<?xml version="1.0" encoding="utf-8"?>
<!-- Отметка столпа на тёмном небе, не нажата. 32dp внутри клетки 40dp. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="4dp">
    <shape android:shape="rectangle">
        <solid android:color="#14FFFFFF" />
        <stroke android:width="1dp" android:color="#663EE08A" />
        <corners android:radius="10dp" />
    </shape>
</inset>
